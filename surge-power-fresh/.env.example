# Local development defaults. Copy to .env locally; never commit real credentials.
SURGE_ENV=development
SURGE_AUTO_CREATE_SCHEMA=true
SURGE_TIMEZONE=America/Phoenix
DATABASE_URL=sqlite:///surge-flask.db
PUBLIC_BASE_URL=

# For production only: provide a persistent, high-entropy value via the host secret store.
SURGE_SECRET=

# Optional outbound email. Sending remains owner initiated.
SURGE_SMTP_HOST=
SURGE_SMTP_PORT=587
SURGE_SMTP_FROM=
SURGE_SMTP_TLS=true
SURGE_SMTP_USERNAME=
SURGE_SMTP_PASSWORD=
