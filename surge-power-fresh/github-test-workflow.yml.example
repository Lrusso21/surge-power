name: Test Surge Power
on: [push, pull_request]
permissions:
  contents: read
jobs:
  test:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: surge-power-fresh
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
          cache: pip
          cache-dependency-path: surge-power-fresh/requirements.txt
      - run: pip install -r requirements.txt
      - run: pytest -q
